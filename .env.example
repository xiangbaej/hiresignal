# HireSignal 환경변수
#
# 현재 이 프로젝트는 비밀값을 사용하지 않습니다.
# 4개 ATS(Greenhouse/Lever/Ashby/SmartRecruiters)와 Wayback CDX 모두
# 인증 없는 공개 엔드포인트입니다. 아래는 성능 튜닝 값이며 전부 선택 사항입니다.

# 보드 동시 조회 수. 높이면 빨라지지만 레이트리밋 위험이 커집니다.
SCAN_CONCURRENCY=6

# 단일 HTTP 요청 타임아웃 (ms)
SCAN_TIMEOUT_MS=20000

# ── 향후 계획 ──
# 콜드메일 초안 생성(유료 기능)을 붙일 때 OPENAI_API_KEY가 필요해집니다.
# 일일 스캔과 리드 산출에는 필요 없습니다. 기술스택 추출은 LLM이 아니라
# 사전 매칭으로 처리하므로, 스캔 원가는 0원으로 유지됩니다.
#
# 저장소를 Postgres로 이관하면 DATABASE_URL이 추가됩니다. 현재는 파일 기반
# (data/state.json + append-only 원장)이라 필요하지 않습니다.
